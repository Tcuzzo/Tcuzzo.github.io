flowchart TD
    Request["Request the configured model"] --> Answer{"Model answered?"}
    Answer -- Yes --> Validate["Check proposed tool arguments"]
    Validate --> Tool["Apply policy and run permitted tools"]
    Tool --> Record["Record real results or tool failures"]
    Answer -- No --> Failure["Record model failure"]
    Failure --> Fallback{"Applicable configured fallback and budget remain?"}
    Fallback -- Yes --> Request
    Fallback -- No --> Stop["End with the actual failure"]
    class Request,Validate,Tool,Record,Failure step;
    class Answer,Fallback req;
    class Stop bad;
