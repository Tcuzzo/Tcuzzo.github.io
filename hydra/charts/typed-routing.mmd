flowchart TD
    Request["Typed decision request"] --> Config["Read public provider configuration"]
    Config --> Route{"Applicable configured route"}
    Route --> Local["Local decision model"]
    Route --> Cloud["Direct cloud decision model"]
    Local --> Reply["Record the model result"]
    Cloud --> Reply
    Reply --> Caller["Return result to the caller for its checks"]
    Caller -- Tool proposal --> Policy["Validate tool arguments and apply policy"]
    Policy --> Tool["Run permitted tool"]
    Tool --> Result["Record the actual tool result"]
    class Request,Config,Local,Cloud,Reply,Caller,Tool step;
    class Route,Policy req;
    class Result ok;
