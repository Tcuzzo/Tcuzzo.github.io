flowchart TD
    A["Request and configured roles"] --> V{"At least one role available?"}
    V -- No --> U["Stop: no available capability"]
    V -- Yes --> B{"Matching receipt still valid?"}
    B -- Yes --> C["Reuse the recorded role decision"]
    B -- No --> D["Needle scores role matches"]
    D --> E["Fleet asks its typed decision ladder: local Kev rungs, then cloud Jev"]
    E --> F{"Eligible typed choice passes confidence and probability checks?"}
    F -- Yes --> J["Record the selected role and reason"]
    F -- No --> G{"Needle choice is available and passes similarity and margin checks?"}
    G -- Yes --> J
    G -- No --> H["First available fallback: build, work, then plan"]
    H --> J
    class A,D,E,H step
    class C,J ok
    class B,F,G,V req
    class U bad
